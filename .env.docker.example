# Copy to .env.docker for `docker compose --env-file .env.docker up -d --build`. NEVER commit .env.docker
# Used by docker-compose.yml (and passed into the API container).

# Public address of the portal on the college server (DNS A record -> this server)
SITE_DOMAIN=innovation.nandha.ac.in
# Database name inside the bundled MongoDB
MONGO_DB_NAME=nec_innovation_lab
# Email domain shown on the signup form (the API enforces ALLOWED_EMAIL_DOMAIN)
COLLEGE_EMAIL_DOMAIN=nandhaengg.org

# ---- API (same meaning as server/.env.example) ----
NODE_ENV=production
JWT_SECRET=change_me_to_64_random_characters
JWT_EXPIRES_IN=1d
ALLOWED_EMAIL_DOMAIN=nandhaengg.org
GITHUB_TOKEN=
JOBS_ENABLED=true
RESEND_API_KEY=
MAIL_FROM=NEC Innovation Lab <noreply@innovation.nandha.ac.in>
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=nec-innovation-lab
S3_PREFIX=students-projects/
S3_PUBLIC_BASE_URL=
LOTUS_API_URL=
LOTUS_API_KEY=
LOTUS_MONTHLY_QUOTA=500
