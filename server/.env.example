# Copy this file to .env and fill in real values. NEVER commit .env
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<cluster>
# Database inside the cluster (used even when the URI has no /<db> path)
MONGO_DB_NAME=nec_innovation_lab
# Local only, if you see 'querySrv ECONNREFUSED': DNS_SERVERS=1.1.1.1,8.8.8.8
DNS_SERVERS=
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
# Frontend origin(s) allowed by CORS, comma-separated (local + Netlify + college domain)
CLIENT_URL=http://localhost:5173
# Optional regex for Netlify deploy previews, e.g. ^https://[a-z0-9-]+--nec-innovation-lab\.netlify\.app$
CLIENT_URL_PATTERN=
NODE_ENV=development

# ---- NEC Innovation Lab ----
# Only these email domains may sign up (comma-separated). Confirm the exact domain with college IT.
ALLOWED_EMAIL_DOMAIN=nandhaengg.org
# Read-only GitHub token for repo import (fine-grained, "Public repositories" read-only, no scopes).
# Without it GitHub allows only 60 requests/hour per server IP — about one import.
GITHUB_TOKEN=
# Re-use an import for this long before asking GitHub again
GITHUB_CACHE_MINUTES=30
# Import limits: commits read, commits read with file lists (1 API call each), file/repo size caps
GITHUB_MAX_COMMITS=300
GITHUB_COMMIT_DETAILS=40
GITHUB_MAX_FILE_KB=500
GITHUB_MAX_TARBALL_MB=50
# Daily checks inside the API (live URL uptime, repo refresh, Lab Score). Set to false when an
# external scheduler runs `npm run daily` instead (Render cron job / GitHub Actions schedule).
JOBS_ENABLED=true

# ---- Media uploads to S3 (thumbnails, screenshots, update photos) ----
# IAM user with s3:PutObject on arn:aws:s3:::nec-innovation-lab/students-projects/* only
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=nec-innovation-lab
S3_PREFIX=students-projects/
# Public base URL for uploaded files. Leave empty for https://<bucket>.s3.<region>.amazonaws.com
# Set to your CloudFront domain if you put CloudFront in front of the bucket
S3_PUBLIC_BASE_URL=
UPLOAD_MAX_MB=5

# ---- Lotus Blossom (Saravonix Lotus API; contract in docs/LOTUS_API.md) ----
# Leave LOTUS_API_URL empty in development to use the labelled [MOCK] questions.
# Production never mocks unless LOTUS_MOCK=true is set explicitly.
LOTUS_API_URL=
LOTUS_API_KEY=
LOTUS_MOCK=
# Question sets (and separately, scorings) the portal may request per calendar month
LOTUS_MONTHLY_QUOTA=500
