# Copy to .env — Vite exposes only variables prefixed with VITE_
# Local: http://localhost:5000/api   Netlify: https://<your-app>.up.railway.app/api
VITE_API_URL=http://localhost:5000/api
# Shown as a hint on the signup form; the server enforces ALLOWED_EMAIL_DOMAIN
VITE_COLLEGE_DOMAIN=nandhaengg.org
# Google OAuth web client id (college Workspace). Leave empty to hide "Sign in with Google".
VITE_GOOGLE_CLIENT_ID=
